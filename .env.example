# OpenRouter Configuration
# Note: Use DeepSeek as instructed (e.g., deepseek/deepseek-chat)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-chat

# Email Dispatch Configuration (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_APP_PASSWORD=your_16_character_app_password

# Testing & Safety Routing
# Row 1 will be delivered to TEST_EMAIL; other mock rows will be saved locally as HTML
TEST_EMAIL=your_test_email@example.com

# Optional Live Google Sheet CSV URL (defaults to data/hotel_performance.xlsx if empty)
GOOGLE_SHEET_URL=
